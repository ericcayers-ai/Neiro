{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neiro",
  "version": "1.2.1",
  "identifier": "app.neiro.desktop",
  "build": {
    "frontendDist": "../src/neiro/ui/static",
    "devUrl": "http://127.0.0.1:8377",
    "beforeDevCommand": "npm --prefix frontend run build",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/engine"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDNjkxM0ExN0RDMkExQ0MKUldUTW9jSjlvUk5wSENoSTJjMFFTd1pJK2Z6UnVEc3pCcE1zVXQydGtKR0hRMjFJTWN4KzA0NlMK",
      "endpoints": [
        "https://github.com/ericcayers-ai/Neiro/releases/latest/download/latest.json"
      ]
    }
  }
}
